+    // The page this server serves itself is the only browser allowed to run tools: it is part of
+    // this program. Any other origin is a page the user never gave this computer's shell to, so it
+    // is treated like another machine. Sec-Fetch-Site is set by the browser; Origin compared with
+    // Host is the fallback for browsers that do not send it. A request with neither is a program,
+    // not a page, and keeps the rules it had.
+    auto foreign_page = [](const server_http_req & req) {
+        const std::string site = get_header(req.headers, "sec-fetch-site");
+        if (!site.empty()) {
+            return site != "same-origin" && site != "none";
+        }
+        const std::string origin = get_header(req.headers, "origin");
+        if (origin.empty()) {
+            return false;
+        }
+        // an opaque origin (a sandboxed frame, a file:// page) belongs to no server
+        if (origin == "null") {
+            return true;
+        }
+        const auto scheme = origin.find("://");
+        return scheme == std::string::npos || origin.substr(scheme + 3) != get_header(req.headers, "host");
+    };
