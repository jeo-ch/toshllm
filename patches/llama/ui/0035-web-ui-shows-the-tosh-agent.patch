diff --git a/tools/ui/src/lib/components/app/chat/ChatMessages/ChatMessage/ChatMessageAssistant/ToshMap.svelte b/tools/ui/src/lib/components/app/chat/ChatMessages/ChatMessage/ChatMessageAssistant/ToshMap.svelte
new file mode 100644
index 000000000..2f26901b7
--- /dev/null
+++ b/tools/ui/src/lib/components/app/chat/ChatMessages/ChatMessage/ChatMessageAssistant/ToshMap.svelte
@@ -0,0 +1,145 @@
+<script lang="ts">
+	import 'leaflet/dist/leaflet.css';
+	import ToshResize from './ToshResize.svelte';
+	import { download } from '$lib/tosh/download';
+	import { bundle, geojsonFiles } from '$lib/tosh/map';
+	import type { ToshMapLayer } from '$lib/types';
+	import type { Map as LeafletMap } from 'leaflet';
+	import { onDestroy, onMount, tick } from 'svelte';
+
+	interface Props {
+		layers: ToshMapLayer[];
+	}
+
+	let { layers }: Props = $props();
+
+	const COLORS = ['#3b82f6', '#ef4444', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899'];
+
+	let element: HTMLDivElement;
+	let map: LeafletMap | null = null;
+	let destroyed = false;
+	let enlarged = $state(false);
+
+	async function resize() {
+		enlarged = !enlarged;
+		await tick();
+		map?.invalidateSize();
+	}
+
+	function escape(value: unknown): string {
+		return String(value ?? '').replace(
+			/[<>&"]/g,
+			(c) => ({ '"': '&quot;', '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c] ?? c
+		);
+	}
+
+	/** The attributes of a feature in the layer's own order, with the names ArcGIS shows for them. */
+	function popup(properties: Record<string, unknown>, layer: ToshMapLayer): string {
+		const names = layer.fields?.length
+			? layer.fields
+			: Object.keys(properties).map((name) => ({ alias: name, name }));
+		const rows = names
+			.filter(
+				(f) =>
+					properties[f.name] !== null &&
+					properties[f.name] !== undefined &&
+					properties[f.name] !== ''
+			)
+			.slice(0, 40)
+			.map(
+				(f) =>
+					`<tr><th style="text-align:left;padding-right:8px">${escape(f.alias ?? f.name)}</th><td>${escape(properties[f.name])}</td></tr>`
+			);
+
+		return `<div style="max-height:220px;overflow:auto;font-size:12px"><b>${escape(layer.title)}</b><table>${rows.join('')}</table></div>`;
+	}
+
+	// Leaflet touches window when imported, so it loads in the browser only.
+	onMount(async () => {
+		const L = (await import('leaflet')).default;
+
+		if (destroyed) return;
+
+		map = L.map(element, { attributionControl: true, scrollWheelZoom: false });
+		L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
+			attribution: '&copy; OpenStreetMap',
+			maxZoom: 19
+		}).addTo(map);
+		const group = L.featureGroup();
+
+		layers.forEach((layer, index) => {
+			const color = COLORS[index % COLORS.length];
+
+			L.geoJSON(
+				{ features: layer.features, type: 'FeatureCollection' } as GeoJSON.FeatureCollection,
+				{
+					onEachFeature: (feature, drawn) =>
+						drawn.bindPopup(popup(feature.properties ?? {}, layer)),
+					pointToLayer: (_feature, at) =>
+						L.circleMarker(at, { color, fillOpacity: 0.8, radius: 5, weight: 1 }),
+					style: { color, dashArray: layer.drawn ? '6 4' : undefined, fillOpacity: 0.15, weight: 2 }
+				}
+			).addTo(group);
+		});
+
+		group.addTo(map);
+		const bounds = group.getBounds();
+
+		if (bounds.isValid()) map.fitBounds(bounds, { maxZoom: 17, padding: [20, 20] });
+		else map.setView([0, 0], 2);
+	});
+
+	onDestroy(() => {
+		destroyed = true;
+		map?.remove();
+	});
+
+	function exportGeojson() {
+		const file = bundle(geojsonFiles(layers));
+
+		if (file) download(file.name, file.data, file.type);
+	}
+</script>
+
+<div class="grid gap-1.5">
+	<!-- the size goes on a wrapper: Leaflet keeps classes of its own on the map's element -->
+	<div class="w-full overflow-hidden rounded-lg {enlarged ? 'h-[460px]' : 'h-56'}">
+		<div bind:this={element} class="h-full w-full"></div>
+	</div>
+
+	<div class="flex flex-wrap items-start justify-between gap-2 text-[11px] text-muted-foreground">
+		<span class="flex flex-wrap gap-3">
+			{#each layers as layer, index (index)}
+				<span class="inline-flex items-center gap-1">
+					<span
+						class="inline-block h-2 w-2 rounded-full"
+						style="background:{COLORS[index % COLORS.length]}"
+					></span>
+
+					{#if layer.link?.url && /^https?:\/\//.test(layer.link.url)}
+						<a
+							class="underline-offset-2 hover:underline"
+							href={layer.link.url}
+							rel="noopener noreferrer"
+							target="_blank">{layer.title ?? layer.link.title ?? 'Layer'}</a
+						>
+					{:else}
+						{layer.title ?? 'Layer'}
+					{/if}{layer.complete === false ? ' (partial)' : ''}{layer.drawn ? ' (approximate)' : ''}
+					{#if layer.subtitle}<span class="opacity-75">{layer.subtitle}</span>{/if}
+				</span>
+			{/each}
+		</span>
+
+		<span class="flex items-center gap-3">
+			<ToshResize {enlarged} onclick={resize} />
+
+			<button
+				class="hover:text-foreground"
+				onclick={exportGeojson}
+				title="One .geojson file per layer and kind of geometry, for ArcGIS Pro (JSON To Features)"
+				>GeoJSON</button
+			>
+		</span>
+	</div>
+</div>
